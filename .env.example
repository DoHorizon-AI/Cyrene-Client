# Copy to .env.local and restart npm run dev. Keep service credentials on Web Host.
# Browser pairing uses the host's one-time code, never a cloud/provider credential.
STUDIO_NAVIGATOR_URL=http://127.0.0.1:8100

# Optional organization identity UI. Requires the authenticated ACA edge and
# Workspace BFF; local Vite/Compose deliberately return unavailable for its API.
# VITE_WORKSPACE_BFF_ENABLED=false

# Default full control mode: npm run dev (Node 24+); dev:legacy keeps the limited JSON bridge.
# STUDIO_CONTROL_DATA_DIR=.studio
# STUDIO_LOCAL_API_TOKEN=generate-a-dedicated-random-token-for-local-mcp
# Team mode requires PostgreSQL; never set a VITE_ prefix on credentials.
# STUDIO_MODE=team
# STUDIO_DATABASE_URL=postgresql://studio:password@127.0.0.1:5432/studio
# STUDIO_PUBLIC_ORIGINS=http://127.0.0.1:5180
# STUDIO_NODE_PACKAGES_DIR=node-packages
# GitHub Actions build configuration is server-only; see docs/node-builds.md.
# STUDIO_BUILD_PROFILES_FILE=/absolute/path/to/build-profiles.json
# STUDIO_GITHUB_TOKEN=repository-scoped-actions-write-and-contents-read-token
# Optional Product execution adapters. Tokens are service credentials scoped to
# the configured workspace; use exactly one of TOKEN and TOKEN_FILE per Product.
# STUDIO_YIELD_EXECUTION_URL=https://yield.internal.example
# STUDIO_YIELD_EXECUTION_TOKEN=service-credential
# STUDIO_YIELD_EXECUTION_TOKEN_FILE=/run/secrets/studio_yield_execution_token
# STUDIO_ECHO_EXECUTION_URL=https://echo.internal.example
# STUDIO_ECHO_EXECUTION_TOKEN=service-credential
# STUDIO_ECHO_EXECUTION_TOKEN_FILE=/run/secrets/studio_echo_execution_token

# MCP HTTP: /studio-mcp (Streamable HTTP, negotiated SDK version 2025-11-25).
# HTTP MCP + embedded assistant tool catalog can be restricted to reads.
# STUDIO_MCP_READ_ONLY=1
# Optional diagnostic CPU workload, disabled by default; no GPU or external calls.
# STUDIO_LOCAL_DIAGNOSTICS=1
# Optional embedded assistant. URL is the complete Chat Completions endpoint.
# Provider must support function tools. Keys stay on the control server.
# STUDIO_ASSISTANT_URL=https://your-provider.example/v1/chat/completions
# STUDIO_ASSISTANT_MODEL=your-model
# STUDIO_ASSISTANT_API_KEY_FILE=/run/secrets/studio_assistant_key
# Or STUDIO_ASSISTANT_API_KEY, but not both key sources.
# External stdio clients: point to the SAME control service, never a second store.
# STUDIO_CONTROL_URL=http://127.0.0.1:5280
# STUDIO_API_TOKEN=dedicated-api-token
# Historical file-backed stdio mode only: STUDIO_MCP_LEGACY_FILES=1
