{
  "name": "@cyrene/studio-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "mcp": "tsx apps/mcp/main.ts",
    "dev": "vite --host 127.0.0.1",
    "dev:services": "node scripts/dev.mjs",
    "control": "node --env-file-if-exists=.env.local --import tsx apps/control/main.ts",
    "team:bootstrap": "node --env-file-if-exists=.env.local --import tsx apps/control/main.ts --bootstrap-admin",
    "control:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-control.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:control": "playwright test --config playwright.control.config.ts",
    "test:containers": "tsx scripts/verify-containers.ts",
    "check": "npm test && npm run build && npm run test:e2e && npm run test:e2e:control"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "elkjs": "0.12.0",
    "fflate": "0.8.3",
    "litegraph.js": "0.7.14",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
